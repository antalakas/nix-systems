#!/usr/bin/env bash
# Run Claude Code in a sandboxed Docker container
# Usage: claude-sandbox [--profile NAME] [--owner NAME] [--rebuild] [project-dir] [-- claude-args...]
#
# Examples:
#   claude-sandbox                              # current dir, default (work) profile
#   claude-sandbox --rebuild                    # rebuild image to get latest version
#   claude-sandbox --profile personal           # current dir, personal profile
#   claude-sandbox --profile personal ~/proj    # specific project, personal profile
#   claude-sandbox --owner TileDB-Inc           # force a GitHub owner's token
#   claude-sandbox . -- --continue              # pass args to claude
#   claude-sandbox . -- "Fix the login bug"     # pass a prompt
#
# GitHub tokens are selected per-workspace. Fine-grained PATs are scoped to a
# single resource owner, so one token cannot span owners; keep one per owner in
# ~/.config/claude-code/github-tokens (mode 0600, never in the nix store):
#   antalakas=github_pat_...
#   TileDB-Inc=github_pat_...
# The owner is read from the project's `origin` remote, so only that owner's
# token is injected. Override with --owner, or set a `default=` entry.
#
# Mind the trust boundary: that remote comes from the workspace's own .git/config,
# which the repo you opened controls. Pass --owner when opening a repo whose git
# config you have not vetted. See the token selection section below.
#
# When a token is selected, GitHub SSH remotes are rewritten to HTTPS inside the
# container and authenticated with it, so plain git fetch/push work despite the
# sandbox having no SSH keys.
#
# Profiles live in ~/.claude-profiles/<name>/ with .claude/ and .claude.json,
# and optionally .aws/ — see the AWS credential selection section below.
# Mempalace data is kept in per-profile Docker volumes:
#   claude-code-sandbox-<profile>-mempalace -> /home/node/.mempalace
#   claude-code-sandbox-<profile>-cache     -> /home/node/.cache
# To set up a new profile:
#   mkdir -p ~/.claude-profiles/personal/.claude
#   claude-sandbox --profile personal   # then run /login inside

set -e

IMAGE_NAME="claude-code-sandbox"
PROFILE="work"
REBUILD=false
OWNER_OVERRIDE=""

# Parse flags
while [ $# -gt 0 ]; do
    case "$1" in
        --profile)
            PROFILE="$2"
            shift 2
            ;;
        --owner)
            OWNER_OVERRIDE="$2"
            shift 2
            ;;
        --rebuild)
            REBUILD=true
            shift
            ;;
        *)
            break
            ;;
    esac
done

PROJECT_DIR="${1:-.}"

# Resolve to absolute path
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"

# Shift past project dir if provided, then past -- separator
if [ "$1" ] && [ "$1" != "--" ]; then
    shift
fi
if [ "$1" = "--" ]; then
    shift
fi

# Resolve persistent Mempalace volumes based on profile. The .mempalace
# volume stores ChromaDB; the cache volume stores the default embedding model.
SAFE_PROFILE="$(printf '%s' "$PROFILE" | tr -c '[:alnum:]_.-' '-')"
MEMPALACE_VOLUME_PREFIX="claude-code-sandbox-$SAFE_PROFILE"
MEMPALACE_DIR="/home/node/.mempalace"
MEMPALACE_CACHE_DIR="/home/node/.cache"
MEMPALACE_VOLUME="${CLAUDE_SANDBOX_MEMPALACE_VOLUME:-$MEMPALACE_VOLUME_PREFIX-mempalace}"
MEMPALACE_CACHE_VOLUME="${CLAUDE_SANDBOX_MEMPALACE_CACHE_VOLUME:-$MEMPALACE_VOLUME_PREFIX-cache}"
MEMPALACE_PALACE_PATH="$MEMPALACE_DIR/palace"

# Resolve credential paths based on profile
PROFILE_DIR="$HOME/.claude-profiles/$PROFILE"
if [ -d "$PROFILE_DIR" ]; then
    CLAUDE_DIR="$PROFILE_DIR/.claude"
    CLAUDE_JSON="$PROFILE_DIR/.claude.json"
    mkdir -p "$CLAUDE_DIR"
    # Ensure .claude.json exists as a file (Docker mounts missing files as directories)
    [ -f "$CLAUDE_JSON" ] || echo '{}' > "$CLAUDE_JSON"
    # Seed settings.json with defaults if missing
    [ -f "$CLAUDE_DIR/settings.json" ] || cat > "$CLAUDE_DIR/settings.json" << 'SETTINGS'
{
  "model": "claude-opus-4-7",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true
}
SETTINGS
else
    # Fallback to default locations (backwards compatible)
    CLAUDE_DIR="$HOME/.claude"
    CLAUDE_JSON="$HOME/.claude.json"
fi

# Build image if it doesn't exist, or if --rebuild was requested
DOCKERFILE="$(readlink -f ~/.config/claude-code/Dockerfile)"
if $REBUILD; then
    echo "Rebuilding Claude Code sandbox image (refreshing base image too)..."
    docker build --pull --no-cache -t "$IMAGE_NAME" -f "$DOCKERFILE" "$(dirname "$DOCKERFILE")"
elif ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
    echo "Building Claude Code sandbox image (first time only)..."
    docker build --pull -t "$IMAGE_NAME" -f "$DOCKERFILE" "$(dirname "$DOCKERFILE")"
fi

# --- GitHub token selection -------------------------------------------------
# Fine-grained PATs are scoped to one resource owner, so we keep one token per
# owner and inject only the one matching this workspace. That keeps each owner's
# token out of sandboxes opened on your other owners' repos.
#
# This is cross-contamination control between repos you trust, not a security
# boundary. The owner is derived from the workspace's `origin` remote, i.e. from
# data the repo itself supplies, so a repo that points origin at another owner
# attracts that owner's token. `git remote get-url` also applies any
# url.*.insteadOf rewrites from the same config. Use --owner to decide the owner
# yourself when the workspace is not one you control.
TOKENS_CONF="$HOME/.config/claude-code/github-tokens"

# Derive the GitHub owner from the project's origin remote.
detect_github_owner() {
    local dir="$1" url path
    url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    [ -n "$url" ] || return 0
    case "$url" in
        git@github.com:*)       path="${url#git@github.com:}" ;;
        ssh://git@github.com/*) path="${url#ssh://git@github.com/}" ;;
        https://github.com/*)   path="${url#https://github.com/}" ;;
        http://github.com/*)    path="${url#http://github.com/}" ;;
        *) return 0 ;;
    esac
    printf '%s' "${path%%/*}"
}

# Look up an owner's token. Owner match is case-insensitive, as GitHub is.
lookup_token() {
    local want="${1,,}" line key val
    [ -f "$TOKENS_CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [[ -z "${line//[[:space:]]/}" || "$line" == \#* ]] && continue
        [[ "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        key="${key//[[:space:]]/}"
        val="${val#"${val%%[![:space:]]*}"}"
        val="${val%"${val##*[![:space:]]}"}"
        if [ "${key,,}" = "$want" ]; then
            printf '%s' "$val"
            return 0
        fi
    done < "$TOKENS_CONF"
}

if [ -n "$OWNER_OVERRIDE" ]; then
    GH_OWNER="$OWNER_OVERRIDE"
else
    GH_OWNER="$(detect_github_owner "$PROJECT_DIR")"
fi

SANDBOX_GH_TOKEN=""
TOKEN_SOURCE=""
if [ -f "$TOKENS_CONF" ]; then
    # Credentials readable beyond their owner leak to every local user. Refuse
    # rather than warn: a warning would scroll past under the session banner.
    PERMS="$(stat -c '%a' "$TOKENS_CONF" 2>/dev/null || echo '')"
    case "$PERMS" in
        # Owner-only modes: group and other bits must be 0. stat drops leading
        # zeros, so mode 000 reports as a bare "0".
        *00|0) ;;
        '')
            echo "❌ Cannot stat $TOKENS_CONF to check its permissions." >&2
            echo "   Refusing to read tokens from a file of unknown mode." >&2
            exit 1
            ;;
        *)
            echo "❌ $TOKENS_CONF is mode $PERMS, readable beyond its owner." >&2
            echo "   Run: chmod 600 $TOKENS_CONF" >&2
            exit 1
            ;;
    esac

    if [ -n "$GH_OWNER" ]; then
        SANDBOX_GH_TOKEN="$(lookup_token "$GH_OWNER" || true)"
        [ -n "$SANDBOX_GH_TOKEN" ] && TOKEN_SOURCE="$GH_OWNER"
    fi
    if [ -z "$SANDBOX_GH_TOKEN" ]; then
        SANDBOX_GH_TOKEN="$(lookup_token default || true)"
        [ -n "$SANDBOX_GH_TOKEN" ] && TOKEN_SOURCE="default"
    fi
else
    # No per-owner config: fall back to the ambient token (legacy behaviour).
    SANDBOX_GH_TOKEN="$GH_TOKEN"
    [ -n "$SANDBOX_GH_TOKEN" ] && TOKEN_SOURCE="\$GH_TOKEN (no $TOKENS_CONF)"
fi

if [ -n "$SANDBOX_GH_TOKEN" ]; then
    GH_TOKEN_STATUS="$TOKEN_SOURCE"
elif [ ! -f "$TOKENS_CONF" ]; then
    GH_TOKEN_STATUS="none (create $TOKENS_CONF)"
elif [ -n "$GH_OWNER" ]; then
    GH_TOKEN_STATUS="none (no entry for '$GH_OWNER' in $TOKENS_CONF)"
else
    GH_TOKEN_STATUS="none (no GitHub origin remote; use --owner)"
fi

# --- AWS credential selection -----------------------------------------------
# Prefer a per-profile ~/.claude-profiles/<profile>/.aws over the host's ~/.aws.
#
# A personal IAM identity is the wrong thing to hand an agent: it carries the
# owner's entire blast radius, and if it is MFA-gated — the usual way a personal
# user is protected — every call fails anyway, since an agent cannot satisfy a
# second factor. The fix is a scoped IAM user per profile: drop its credentials
# in the profile's .aws/ and only that identity enters this container.
#
# Falling back to ~/.aws keeps existing setups working, so the banner names
# which of the two was chosen rather than leaving it to be discovered by an
# unexpected AccessDenied. Override with CLAUDE_SANDBOX_AWS_DIR=<path>, or
# =none to mount no credentials at all.
AWS_DIR="${CLAUDE_SANDBOX_AWS_DIR:-}"
AWS_STATUS=""
if [ "$AWS_DIR" = "none" ]; then
    AWS_DIR=""
    AWS_STATUS="none (CLAUDE_SANDBOX_AWS_DIR=none)"
elif [ -n "$AWS_DIR" ]; then
    if [ ! -d "$AWS_DIR" ]; then
        # Docker would create the missing path as an empty root-owned directory
        # and the container would silently have no credentials. Say so instead.
        echo "❌ CLAUDE_SANDBOX_AWS_DIR=$AWS_DIR is not a directory." >&2
        exit 1
    fi
    AWS_STATUS="$AWS_DIR (CLAUDE_SANDBOX_AWS_DIR)"
elif [ -d "$PROFILE_DIR/.aws" ]; then
    AWS_DIR="$PROFILE_DIR/.aws"
    AWS_STATUS="$AWS_DIR (profile)"
elif [ -d "$HOME/.aws" ]; then
    AWS_DIR="$HOME/.aws"
    AWS_STATUS="$AWS_DIR (host fallback — your personal identity)"
else
    AWS_STATUS="none"
fi

echo "🔒 Starting Claude Code in sandbox"
echo "   Profile: $PROFILE"
echo "   Project: $PROJECT_DIR"
echo "   GitHub:  owner=${GH_OWNER:-<unknown>} token=$GH_TOKEN_STATUS"
echo "   AWS:     $AWS_STATUS"
echo "   Mempalace: $MEMPALACE_VOLUME -> $MEMPALACE_DIR"
echo "   Cache: $MEMPALACE_CACHE_VOLUME -> $MEMPALACE_CACHE_DIR"
if [ -n "${MEMPALACE_MINE_CPUS:-}" ]; then
    echo "   Miner CPUs: $MEMPALACE_MINE_CPUS (host override; image default is 6)"
fi
echo ""

DOCKER_ARGS=(
    -it --rm
    -v "$PROJECT_DIR:/workspace"
    -v "$CLAUDE_DIR:/home/node/.claude"
    -v "$CLAUDE_JSON:/home/node/.claude.json"
    -v "$HOME/.config/claude:/home/node/.config/claude"
    -v "$MEMPALACE_VOLUME:$MEMPALACE_DIR"
    -v "$MEMPALACE_CACHE_VOLUME:$MEMPALACE_CACHE_DIR"
    -e MEMPALACE_PALACE_PATH="$MEMPALACE_PALACE_PATH"
    -e MEMPAL_DIR="/workspace"
    -e XDG_CACHE_HOME="$MEMPALACE_CACHE_DIR"
    -e HF_HOME="$MEMPALACE_CACHE_DIR/huggingface"
    -e SENTENCE_TRANSFORMERS_HOME="$MEMPALACE_CACHE_DIR/sentence-transformers"
    --network=host
)

# The mempalace miner's CPU cap. The image's mempalace-python-capped wrapper
# reads MEMPALACE_MINE_CPUS at runtime and falls back to 6 — a laptop number,
# picked because the miner pegged 15 of that machine's 22 cores. Nothing carried
# the host's value across before this, so setting it outside the container did
# nothing and a bigger box silently stayed at 6.
#
# Forwarded by name rather than as NAME=value, so leaving it unset on the host
# leaves it unset in the container and the image default applies — passing an
# empty string would floor the cap at 1 instead.
if [ -n "${MEMPALACE_MINE_CPUS:-}" ]; then
    export MEMPALACE_MINE_CPUS
    DOCKER_ARGS+=(-e MEMPALACE_MINE_CPUS)
fi

# Mount kubeconfig if present (for kubectl/helm inside the sandbox).
# rw because cloud-provider auth plugins refresh tokens in the file.
if [ -d "$HOME/.kube" ]; then
    DOCKER_ARGS+=(-v "$HOME/.kube:/home/node/.kube")
fi

# Mount AWS credentials/config (for awscli, EKS auth, etc.). Resolved above.
# Read-only: nothing in the container should be rewriting the host's credentials.
# `aws sso login` cannot work through this and is not meant to — use static keys
# for a scoped user, or run the login on the host and mount the result.
if [ -n "$AWS_DIR" ]; then
    DOCKER_ARGS+=(-v "$AWS_DIR:/home/node/.aws:ro")
fi

# Mount the host's global git config, so commits made in the sandbox carry the
# right identity instead of failing on "Author identity unknown", and so aliases
# and defaults come along. The image ships no gitconfig of its own.
#
# It is regenerated rather than bind-mounted straight from ~/.gitconfig, for two
# reasons. `git config --global --list` finds whichever file actually holds the
# config (home-manager writes ~/.config/git/config, not ~/.gitconfig) and expands
# any [include]. And it lets url.* rewrites be dropped: this host rewrites
# https://github.com/ to git@github.com:, which cannot authenticate in a
# container with no SSH keys. That rule would also defeat the SSH->HTTPS rewrite
# below — git resolves insteadOf by longest match, and the two are the same
# length, a tie the host's rule wins. Nothing in the environment can override it,
# so it has to be left out of the file.
SANDBOX_GITCONFIG="$HOME/.cache/claude-code/gitconfig"
if git config --global --list >/dev/null 2>&1; then
    mkdir -p "$(dirname "$SANDBOX_GITCONFIG")"
    : > "$SANDBOX_GITCONFIG"
    chmod 600 "$SANDBOX_GITCONFIG"
    while IFS= read -r -d '' entry; do
        key="${entry%%$'\n'*}"
        val="${entry#*$'\n'}"
        # A valueless key has no newline, so val came back as the key itself.
        [ "$val" = "$entry" ] && val="true"
        case "$key" in url.*) continue ;; esac
        git config --file "$SANDBOX_GITCONFIG" --add "$key" "$val"
    done < <(git config --global --list --null)
    DOCKER_ARGS+=(-v "$SANDBOX_GITCONFIG:/home/node/.gitconfig:ro")
fi

# Load read-only reference mounts from refs.conf.
#
# Lines are mounted verbatim, so keep each one narrow. A line mounting $HOME, or
# ~/.config/claude-code itself, would hand the container the whole github-tokens
# file and silently undo the per-owner token selection above.
REFS_CONF="$(readlink -f ~/.config/claude-code/refs.conf 2>/dev/null || true)"
if [ -f "$REFS_CONF" ]; then
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        DOCKER_ARGS+=(-v "$line:ro")
    done < "$REFS_CONF"
fi

# Pass API key if set, otherwise browser auth will be used
if [ -n "$ANTHROPIC_API_KEY" ]; then
    DOCKER_ARGS+=(-e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY")
fi

# Pass the workspace's GitHub token (enables gh CLI and Claude GitHub access).
# Resolved above; only this owner's token enters the container.
#
# Export and pass `-e GH_TOKEN` by name, never `-e GH_TOKEN=<value>`: the value
# form puts the token in the docker process's argv, where any local user can
# read it from /proc/<pid>/cmdline for as long as the container runs.
if [ -n "$SANDBOX_GH_TOKEN" ]; then
    export GH_TOKEN="$SANDBOX_GH_TOKEN"
    export GH_OWNER
    DOCKER_ARGS+=(-e GH_TOKEN)
    DOCKER_ARGS+=(-e GH_OWNER)

    # Make plain git work against GitHub. The sandbox mounts no SSH keys, so an
    # `origin` of git@github.com:... cannot authenticate; rewrite those remotes
    # to HTTPS and answer the credential prompt from $GH_TOKEN.
    #
    # The helper is a shell snippet git runs per request, so $GH_TOKEN expands
    # at that moment: the token stays out of .git/config, out of remote URLs,
    # and out of anything git echoes back on failure. Set only when a token
    # exists — without one, leaving SSH alone gives an honest "Permission
    # denied (publickey)" instead of an HTTPS 403. GIT_TERMINAL_PROMPT=0 makes
    # a missing or expired token fail rather than block on a password prompt.
    DOCKER_ARGS+=(
        -e GIT_CONFIG_COUNT=3
        -e GIT_CONFIG_KEY_0='url.https://github.com/.insteadOf'
        -e GIT_CONFIG_VALUE_0='git@github.com:'
        -e GIT_CONFIG_KEY_1='url.https://github.com/.insteadOf'
        -e GIT_CONFIG_VALUE_1='ssh://git@github.com/'
        -e GIT_CONFIG_KEY_2='credential.https://github.com.helper'
        -e GIT_CONFIG_VALUE_2='!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
        -e GIT_TERMINAL_PROMPT=0
    )
fi

exec docker run "${DOCKER_ARGS[@]}" \
    "$IMAGE_NAME" \
    --dangerously-skip-permissions \
    "$@"
